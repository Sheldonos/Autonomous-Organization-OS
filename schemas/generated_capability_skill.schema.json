{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Capability Skill Record",
  "type": "object",
  "required": ["slug", "connector_id", "capability_type", "capability_name", "trust_state", "pocket_routes"],
  "properties": {
    "slug": {"type": "string"},
    "connector_id": {"type": "string"},
    "capability_type": {"enum": ["tool", "resource", "resource_template", "prompt"]},
    "capability_name": {"type": "string"},
    "trust_state": {"type": "string"},
    "risk_class": {"type": "string"},
    "pocket_routes": {"type": "array", "items": {"type": "string"}}
  }
}
